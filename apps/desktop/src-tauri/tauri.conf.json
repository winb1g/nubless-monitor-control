{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nubless",
  "version": "../package.json",
  "identifier": "io.github.winb1g.nubless",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "nubless",
        "url": "index.html",
        "width": 1040,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "visible": false
      },
      {
        "label": "tray",
        "title": "nubless",
        "url": "index.html#/tray",
        "width": 340,
        "height": 500,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "Control your LG 27GM950B without touching the joystick nub",
    "category": "Utility"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGNzhCQUY5NzcyOTVEODYKUldTR1hTbDMrYnA0SDhxWWdDVjJwZ2ZuZ3YrNVR6eEVMbFRGcWdQMUxaSDMxVlVmS1pVcHFmSHAK",
      "endpoints": ["https://github.com/winb1g/nubless-monitor-control/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
